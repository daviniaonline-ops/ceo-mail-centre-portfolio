# Copy this file to .env and fill in your own values.
# .env is ignored by git. Never commit real keys.

# --- Optional: turns on "Draft with Claude" when running outside claude.ai ---
# Create a key at https://console.anthropic.com (usage is billed to that account).
# Leave as-is to run without drafting; templates and everything else still work.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model used for drafting and for reading pasted screens.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a stronger model for "Draft with Claude" (the app asks for the "complex" tier there).
# ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=2000

# --- Local server ---
PORT=3000
# Keep 127.0.0.1 so only this computer can reach it. The server has no login,
# so anyone who can reach it could use your API key.
HOST=127.0.0.1
